{
  "name": "dsh-cf",
  "version": "0.1.0-alpha.7",
  "description": "Owner-only Cloudflare Access and Tunnel integration for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "check:dsh": "node scripts/dsh-compat.mjs",
    "check:dsh:smoke": "node scripts/dsh-smoke.mjs",
    "test:live": "node scripts/live-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aero123421/dsh-cf.git"
  },
  "keywords": [
    "dsh-plugin",
    "cloudflare",
    "cloudflared",
    "webauthn"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-alpha.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "semver": "7.8.5"
  }
}
